#!/usr/bin/env python3
import argparse
import base64
import os
import re
import sys
import wave

# google-genai SDK は仮想環境内のものをインポートするため、
# 起動時に正しく仮想環境のライブラリがロードされる必要があります。
# CLIコマンドとして動作させる場合、シバンで仮想環境のpythonを指定するか、
# または実行時に動的にsys.pathを解決するかですが、
# 一般的には `t2s` 自体を直接実行可能にし、仮想環境の python インタプリタで起動するのがスマートです。
# ここでは標準のインポートを行い、呼び出し側で仮想環境の python を使用するか、
# 後ほどラッパーを作成する形をとります。

# 自身のスクリプトと同じディレクトリにある仮想環境 (.venv) の Python を自動的に使用して再実行します。
# これにより、名前空間パッケージ (google.*) のインポート競合や、仮想環境のアクティベート漏れを完全に防止します。
script_dir = os.path.dirname(os.path.realpath(__file__))
venv_python = os.path.join(script_dir, ".venv", "bin", "python3")

# 仮想環境のPythonが存在し、かつ現在起動中のPythonがそれと異なる場合、再起動する
if os.path.exists(venv_python) and os.path.abspath(sys.executable) != os.path.abspath(venv_python):
    try:
        os.execv(venv_python, [venv_python] + sys.argv)
    except Exception as e:
        print(f"警告: 仮想環境のPythonでの再実行に失敗しました: {e}", file=sys.stderr)


def clean_markdown(text: str) -> str:
    """Markdownの記号を除去・クレンジングする簡易処理"""
    # 1. コードブロック (```...```) の中身を丸ごと削除
    text = re.sub(r'```[\s\S]*?```', '', text)
    # 2. インラインコード (`) の除去（中身は残す）
    text = re.sub(r'`([^`\n]+)`', r'\1', text)
    # 3. 見出し記号 (#) の除去（行頭の#とスペース）
    text = re.sub(r'^#+\s+', '', text, flags=re.MULTILINE)
    # 4. 箇条書き記号 (-, *, +, 数字.) の除去
    text = re.sub(r'^[-\*\+]\s+', '', text, flags=re.MULTILINE)
    text = re.sub(r'^\d+\.\s+', '', text, flags=re.MULTILINE)
    # 5. 太字・斜体 (**, *, __, _) の除去
    text = re.sub(r'\*\*([^*]+)\*\*|__([^_]+)__', r'\1\2', text)
    text = re.sub(r'\*([^*]+)\*|_([^_]+)_', r'\1\2', text)
    # 6. 画像マークダウン (![alt](url)) の除去
    text = re.sub(r'!\[[^\]]*\]\([^)]+\)', '', text)
    # 7. リンク [表示名](URL) を 表示名 のみに変換
    text = re.sub(r'\[([^\]]+)\]\([^)]+\)', r'\1', text)
    
    # 余分な空白や空行の整理
    lines = [line.strip() for line in text.split('\n')]
    cleaned_lines = [line for line in lines if line]
    return '\n'.join(cleaned_lines)

def split_text(text: str, max_chars: int = 1000) -> list[str]:
    """テキストを自然な文の境界で最大文字数以下のチャンクに分割する"""
    # 読点や句点、改行などの境界で分割候補を作る
    sentences = re.split(r'(?<=[。？！?\n])', text)
    
    chunks = []
    current_chunk = ""
    
    for sentence in sentences:
        if not sentence.strip():
            continue
            
        # 1つの文が上限を超えている場合は、文字数で強制分割
        if len(sentence) > max_chars:
            if current_chunk:
                chunks.append(current_chunk.strip())
                current_chunk = ""
            
            # 強制的にmax_charsごとに分割
            sub_sentences = [sentence[i:i+max_chars] for i in range(0, len(sentence), max_chars)]
            chunks.extend([s.strip() for s in sub_sentences[:-1]])
            current_chunk = sub_sentences[-1]
        elif len(current_chunk) + len(sentence) > max_chars:
            chunks.append(current_chunk.strip())
            current_chunk = sentence
        else:
            current_chunk += sentence
            
    if current_chunk:
        chunks.append(current_chunk.strip())
        
    return chunks

def parse_yaml_front_matter(text: str) -> tuple[dict[str, str], str]:
    """YAMLフロントマターを極力堅牢にパースする（ライブラリ依存なし）"""
    front_matter = {}
    content = text
    
    # 改行コードの正規化
    normalized_text = text.replace('\r\n', '\n')
    
    # 行頭の --- で始まり、次の --- で終わる部分を探す
    match = re.match(r'^---\n(.*?)\n---\n', normalized_text, re.DOTALL)
    if match:
        yaml_block = match.group(1)
        content = normalized_text[match.end():]
        
        lines = yaml_block.split('\n')
        current_key = None
        current_value = []
        
        for line in lines:
            # 空行のハンドリング
            if not line.strip():
                if current_key:
                    current_value.append("")
                continue
            
            # 新しいキーの検出 (例: scene: "...")
            # 行頭から始まるキー名とコロン
            key_match = re.match(r'^([a-zA-Z0-9_-]+)\s*:\s*(.*)$', line)
            if key_match:
                # 既存のキーを保存
                if current_key:
                    front_matter[current_key] = "\n".join(current_value).strip()
                
                current_key = key_match.group(1).lower().replace('-', '_')
                val = key_match.group(2).strip()
                current_value = [val]
            else:
                # インデントされた行や継続行
                if current_key:
                    current_value.append(line.strip())
        
        # 最後のキーを保存
        if current_key:
            front_matter[current_key] = "\n".join(current_value).strip()
            
        # 各値のクォーテーション文字やブロックスカラー記号を剥ぎ取る
        for k, v in front_matter.items():
            if v.startswith('|') or v.startswith('>'):
                v = v[1:].lstrip('\n')
            if len(v) >= 2:
                if (v.startswith('"') and v.endswith('"')) or (v.startswith("'") and v.endswith("'")):
                    v = v[1:-1]
            front_matter[k] = v
            
    return front_matter, content

def build_prompt(transcript: str, audio_profile: str = None, scene: str = None, directors_notes: str = None, sample_context: str = None) -> str:
    """演出用のパラメータをGemini TTS向けの構造化プロンプト形式に構築する"""
    parts = []
    if audio_profile:
        parts.append(f"# AUDIO PROFILE: {audio_profile}")
    if scene:
        parts.append(f"## THE SCENE: {scene}")
    if directors_notes:
        parts.append(f"### DIRECTOR'S NOTES\n{directors_notes}")
    if sample_context:
        parts.append(f"### SAMPLE CONTEXT\n{sample_context}")
        
    if parts:
        parts.append(f"#### TRANSCRIPT\n{transcript}")
        return "\n\n".join(parts)
    else:
        return transcript

def main():
    AVAILABLE_MODELS = [
        "gemini-3.1-flash-tts-preview",
        "gemini-2.5-pro-preview-tts",
        "gemini-2.5-flash-preview-tts"
    ]
    
    AVAILABLE_VOICES = [
        "Despina",
        "Puck",
        "Charon",
        "Kore",
        "Fenrir",
        "Aoede"
    ]

    parser = argparse.ArgumentParser(
        description="MarkdownテキストからGoogle AI Studio (Gemini) を利用して音声(WAV)ファイルを生成するCLIツール",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter
    )
    parser.add_argument("input_file", help="入力Markdownファイルのパス")
    parser.add_argument("output_file", help="出力WAVファイルのパス")
    parser.add_argument(
        "-m", "--model",
        default="gemini-2.5-flash-preview-tts",
        choices=AVAILABLE_MODELS,
        help="使用するGeminiモデル。音声生成（TTS）に対応しているプレビューモデルを指定します。"
    )
    parser.add_argument(
        "-v", "--voice",
        default="Despina",
        choices=AVAILABLE_VOICES,
        help="話者の声。Geminiがサポートするプリビルドのボイスから選択します。"
    )
    parser.add_argument(
        "-c", "--chunk-size",
        type=int,
        default=1000,
        help="分割する際の目安となる最大文字数"
    )
    parser.add_argument(
        "-ap", "--audio-profile",
        default=None,
        help="音声のキャラクターペルソナや声質詳細（例: '女性ボイス、落ち着いたトーン'）"
    )
    parser.add_argument(
        "-sc", "--scene",
        default=None,
        help="音声生成時の音響空間や感情的な雰囲気（例: '静かな部屋', '残響のある広い大聖堂'）"
    )
    parser.add_argument(
        "-dn", "--directors-notes",
        default=None,
        help="話速、スタイル、アクセントなどの演技指示（例: 'ゆっくり、囁くように'）"
    )
    parser.add_argument(
        "-sctx", "--sample-context",
        default=None,
        help="話し始めの文脈や状況のヒント（例: '昔話を優しく語り聞かせる場面'）"
    )
    
    args = parser.parse_args()
    
    # APIキーの検証
    api_key = os.environ.get("GEMINI_API_KEY")
    if not api_key:
        print("エラー: 環境変数 'GEMINI_API_KEY' が設定されていません。", file=sys.stderr)
        print("APIキーを設定してください: export GEMINI_API_KEY='あなたのAPIキー'", file=sys.stderr)
        sys.exit(1)
        
    # 入力ファイルの存在確認
    if not os.path.exists(args.input_file):
        print(f"エラー: 入力ファイルが見つかりません: {args.input_file}", file=sys.stderr)
        sys.exit(1)
        
    # テキストの読み込み
    try:
        with open(args.input_file, 'r', encoding='utf-8') as f:
            raw_text = f.read()
    except Exception as e:
        print(f"エラー: ファイルの読み込みに失敗しました: {e}", file=sys.stderr)
        sys.exit(1)
        
    # フロントマターのパース
    front_matter, text_content = parse_yaml_front_matter(raw_text)
    
    # CLI引数を最優先し、指定がなければフロントマターから取得
    audio_profile = args.audio_profile or front_matter.get("audio_profile")
    scene = args.scene or front_matter.get("scene")
    directors_notes = args.directors_notes or front_matter.get("directors_notes")
    sample_context = args.sample_context or front_matter.get("sample_context")
    
    # クレンジング（フロントマターを省いた本文に対して行う）
    cleaned_text = clean_markdown(text_content)
    if not cleaned_text.strip():
        print("警告: 読み上げるテキストが空です。", file=sys.stderr)
        sys.exit(0)
        
    # 分割
    chunks = split_text(cleaned_text, max_chars=args.chunk_size)
    print(f"テキストを {len(chunks)} 個のチャンクに分割しました。音声生成を開始します...", file=sys.stderr)
    
    # 巨大な google-genai パッケージのインポートを遅延ロード (Lazy Import) します。
    # これにより、-h (--help) や引数エラーなどの場合に、インポートにかかる数秒〜十数秒のオーバーヘッドを完全に回避します。
    try:
        from google import genai
        from google.genai import types
    except ImportError:
        print("エラー: 'google-genai' ライブラリをインポートできません。", file=sys.stderr)
        print("仮想環境を有効にするか、依存ライブラリをインストールしてください。", file=sys.stderr)
        print("セットアップ例: source .venv/bin/activate && pip install -r requirements.txt", file=sys.stderr)
        sys.exit(1)

    # GenAIクライアントの初期化
    try:
        client = genai.Client()
    except Exception as e:
        print(f"エラー: Google GenAI クライアントの初期化に失敗しました: {e}", file=sys.stderr)
        sys.exit(1)
        
    combined_pcm_bytes = bytearray()
    
    # 音声生成用の設定
    config = types.GenerateContentConfig(
        response_modalities=["AUDIO"],
        speech_config=types.SpeechConfig(
            voice_config=types.VoiceConfig(
                prebuilt_voice_config=types.PrebuiltVoiceConfig(
                    voice_name=args.voice
                )
            )
        )
    )
    
    for i, chunk in enumerate(chunks, 1):
        print(f"[{i}/{len(chunks)}] 音声生成中... ({len(chunk)}文字)", file=sys.stderr)
        try:
            # 演出用のプロンプトを構築
            prompt_with_context = build_prompt(
                transcript=chunk,
                audio_profile=audio_profile,
                scene=scene,
                directors_notes=directors_notes,
                sample_context=sample_context
            )
            
            response = client.models.generate_content(
                model=args.model,
                contents=prompt_with_context,
                config=config
            )
            
            # 音声データの抽出
            audio_part = None
            if response.candidates and response.candidates[0].content.parts:
                for part in response.candidates[0].content.parts:
                    if part.inline_data:
                        audio_part = part.inline_data
                        break
            
            if not audio_part or not audio_part.data:
                print(f"エラー: チャンク {i} で音声データを取得できませんでした。", file=sys.stderr)
                sys.exit(1)
                
            raw_data = audio_part.data
            
            # もし返ってきた bytes が Base64 でエンコードされた状態のままであればデコードする
            try:
                if isinstance(raw_data, bytes):
                    decoded = base64.b64decode(raw_data, validate=True)
                    raw_data = decoded
            except Exception:
                pass
                
            combined_pcm_bytes.extend(raw_data)
            
        except Exception as e:
            print(f"エラー: チャンク {i} の処理中にエラーが発生しました: {e}", file=sys.stderr)
            sys.exit(1)
            
    # WAVファイルへの書き出し
    print(f"音声を結合し、WAVファイルを書き出しています: {args.output_file}", file=sys.stderr)
    try:
        # Gemini TTSは通常 24kHz, 16bit, Mono PCM
        with wave.open(args.output_file, 'wb') as wav_file:
            wav_file.setnchannels(1)     # モノラル
            wav_file.setsampwidth(2)      # 16-bit = 2 bytes
            wav_file.setframerate(24000)  # 24kHz
            wav_file.writeframes(combined_pcm_bytes)
        print("音声ファイルの生成が完了しました！", file=sys.stderr)
    except Exception as e:
        print(f"エラー: WAVファイルの保存に失敗しました: {e}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
